# ─────────────────────────────────────────────────────────────────────────────
# Agent Pay demo — environment template. Copy to .env.local and fill in.
# .env.local is gitignored; NEVER commit real keys. Rotate any key that leaks.
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent LLM (drives the Agent Console at /agent) ───────────────────────────
# Provide ONE of these. Gemini is used when GEMINI_API_KEY is set (OpenAI-compat
# endpoint); otherwise OpenRouter is used.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Model id. Defaults: gemini-3.5-flash-lite (Gemini) / an OpenRouter free model.
AGENT_MODEL=

# ── PayPal fiat on-ramp (sandbox) ────────────────────────────────────────────
# From developer.paypal.com → Apps & Credentials (Sandbox).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ── On-chain wallet / settlement (managed server wallet) ─────────────────────
# A server wallet address the treasury disburses to and that signs x402 payments.
AGENT_WALLET_ADDRESS=
AGENTPAY_TREASURY_ADDRESS=
SERVER_WALLET_ADDRESS=
PAY_TO_ADDRESS=
# Chain + RPC for settlement (Arbitrum testnet by default).
AGENTPAY_CHAIN_ID=
AGENTPAY_RPC=
AGENTPAY_USDC=

# Wallet infra credentials (server only; keep secret).
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# ── Demo data source ─────────────────────────────────────────────────────────
CARRY_API_BASE=
PREMIUM_SYMBOL=
